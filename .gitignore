from __future__ import annotations

import os
import tkinter as tk
from dataclasses import dataclass
from pathlib import Path
from tkinter import filedialog, messagebox, ttk
from xml.etree import ElementTree as ET

try:
    from PIL import Image, ImageOps, ImageTk
except ImportError:  # pragma: no cover
    Image = None
    ImageOps = None
    ImageTk = None

try:
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.units import mm
    from reportlab.pdfgen import canvas
except ImportError:  # pragma: no cover
    A4 = None
    mm = None
    canvas = None


@dataclass
class TuckboxConfig:
    card_count: int = 60
    card_width_mm: float = 63.0
    card_height_mm: float = 88.0
    card_thickness_mm: float = 0.30
    clearance_mm: float = 2.0
    bleed_mm: float = 3.0

    @property
    def box_width_mm(self) -> float:
        return max(self.card_count * self.card_thickness_mm + (self.clearance_mm * 2), 5.0)

    @property
    def box_depth_mm(self) -> float:
        return self.card_width_mm + (self.clearance_mm * 2)

    @property
    def box_height_mm(self) -> float:
        return self.card_height_mm + (self.clearance_mm * 2)

    @property
    def total_layout_width_mm(self) -> float:
        return (self.box_width_mm + self.box_depth_mm * 2) + (self.bleed_mm * 2)

    @property
    def total_layout_height_mm(self) -> float:
        return self.box_height_mm + (self.bleed_mm * 2)

    @property
    def front_panel_size_mm(self) -> tuple[float, float]:
        return self.box_width_mm, self.box_height_mm

    @property
    def side_panel_size_mm(self) -> tuple[float, float]:
        return self.box_depth_mm, self.box_height_mm


def mm_to_px(mm_value: float, scale: float = 6.0) -> int:
    return max(1, int(float(mm_value) * scale))


class TuckboxGeneratorApp(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title("Tuckbox Generator")
        self.geometry("1200x760")
        self.minsize(980, 680)

        self.config = TuckboxConfig()
        self.front_image_path: str | None = None
        self.back_image_path: str | None = None
        self.front_photo = None
        self.back_photo = None

        self._build_ui()
        self.refresh_preview()

    def _build_ui(self) -> None:
        main = ttk.Frame(self, padding=12)
        main.pack(fill=tk.BOTH, expand=True)

        left = ttk.Frame(main)
        left.pack(side=tk.LEFT, fill=tk.Y, padx=(0, 12))

        ttk.Label(left, text="Card Settings", font=("Segoe UI", 12, "bold")).pack(anchor="w", pady=(0, 8))

        self.card_count_var = tk.StringVar(value="60")
        self.card_width_var = tk.StringVar(value="63")
        self.card_height_var = tk.StringVar(value="88")
        self.card_thickness_var = tk.StringVar(value="0.30")
        self.clearance_var = tk.StringVar(value="2")
        self.bleed_var = tk.StringVar(value="3")

        fields = [
            ("Card count", self.card_count_var, "int"),
            ("Card width (mm)", self.card_width_var, "float"),
            ("Card height (mm)", self.card_height_var, "float"),
            ("Card thickness (mm)", self.card_thickness_var, "float"),
            ("Clearance (mm)", self.clearance_var, "float"),
            ("Bleed (mm)", self.bleed_var, "float"),
        ]

        for label_text, var, value_type in fields:
            row = ttk.Frame(left)
            row.pack(fill=tk.X, pady=4)
            ttk.Label(row, text=label_text, width=20).pack(side=tk.LEFT)
            ttk.Entry(row, textvariable=var, width=14).pack(side=tk.RIGHT)

        ttk.Button(left, text="Apply Settings", command=self.apply_settings).pack(fill=tk.X, pady=(10, 8))

        ttk.Label(left, text="Artwork", font=("Segoe UI", 12, "bold")).pack(anchor="w", pady=(14, 8))

        ttk.Button(left, text="Choose Front Image", command=self.choose_front_image).pack(fill=tk.X, pady=4)
        ttk.Button(left, text="Choose Back Image", command=self.choose_back_image).pack(fill=tk.X, pady=4)

        self.front_label = ttk.Label(left, text="Front: none selected")
        self.front_label.pack(anchor="w", pady=(6, 2))
        self.back_label = ttk.Label(left, text="Back: none selected")
        self.back_label.pack(anchor="w", pady=(2, 10))

        export_frame = ttk.LabelFrame(left, text="Export")
        export_frame.pack(fill=tk.X, pady=(12, 0))
        ttk.Button(export_frame, text="Export SVG", command=self.export_svg).pack(fill=tk.X, padx=8, pady=8)
        ttk.Button(export_frame, text="Export PDF", command=self.export_pdf).pack(fill=tk.X, padx=8, pady=(0, 8))

        right = ttk.Frame(main)
        right.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

        ttk.Label(right, text="Layout Preview", font=("Segoe UI", 12, "bold")).pack(anchor="w", pady=(0, 8))
        self.canvas = tk.Canvas(right, bg="#f6f6f6", highlightthickness=1, relief="solid")
        self.canvas.pack(fill=tk.BOTH, expand=True)

        summary = ttk.LabelFrame(right, text="Dimensions")
        summary.pack(fill=tk.X, pady=(12, 0))
        self.summary_var = tk.StringVar(value="")
        ttk.Label(summary, textvariable=self.summary_var, justify=tk.LEFT, anchor="w").pack(anchor="w", padx=8, pady=8)

    def apply_settings(self) -> None:
        try:
            self.config = TuckboxConfig(
                card_count=int(self.card_count_var.get()),
                card_width_mm=float(self.card_width_var.get()),
                card_height_mm=float(self.card_height_var.get()),
                card_thickness_mm=float(self.card_thickness_var.get()),
                clearance_mm=float(self.clearance_var.get()),
                bleed_mm=float(self.bleed_var.get()),
            )
            if self.config.card_count <= 0:
                raise ValueError("Card count must be greater than zero.")
            if self.config.card_thickness_mm <= 0:
                raise ValueError("Card thickness must be greater than zero.")
        except ValueError as exc:
            messagebox.showerror("Invalid input", str(exc))
            return

        self.refresh_preview()

    def choose_front_image(self) -> None:
        path = filedialog.askopenfilename(filetypes=[("Image files", "*.png *.jpg *.jpeg *.bmp *.gif *.tif *.tiff")])
        if not path:
            return
        self.front_image_path = path
        self.front_label.config(text=f"Front: {os.path.basename(path)}")
        self.refresh_preview()

    def choose_back_image(self) -> None:
        path = filedialog.askopenfilename(filetypes=[("Image files", "*.png *.jpg *.jpeg *.bmp *.gif *.tif *.tiff")])
        if not path:
            return
        self.back_image_path = path
        self.back_label.config(text=f"Back: {os.path.basename(path)}")
        self.refresh_preview()

    def _load_preview_image(self, image_path: str | None, target_width: int, target_height: int):
        if not image_path or Image is None or ImageTk is None:
            return None

        try:
            img = Image.open(image_path)
            img = ImageOps.exif_transpose(img)
            img = img.convert("RGBA")
            img.thumbnail((target_width, target_height), Image.Resampling.LANCZOS)
            return ImageTk.PhotoImage(img)
        except Exception:
            return None

    def refresh_preview(self) -> None:
        self.canvas.delete("all")

        width = self.config.total_layout_width_mm
        height = self.config.total_layout_height_mm
        scale = 6.0
        canvas_w = mm_to_px(width, scale)
        canvas_h = mm_to_px(height, scale)
        self.canvas.config(width=canvas_w, height=canvas_h)

        front_w_mm, front_h_mm = self.config.front_panel_size_mm
        side_w_mm, side_h_mm = self.config.side_panel_size_mm

        x_front = mm_to_px(self.bleed_mm, scale)
        y_front = mm_to_px(self.bleed_mm, scale)
        front_w = mm_to_px(front_w_mm, scale)
        front_h = mm_to_px(front_h_mm, scale)

        x_left = x_front + front_w
        x_right = x_left + mm_to_px(side_w_mm, scale)

        self.canvas.create_rectangle(x_front, y_front, x_front + front_w, y_front + front_h, outline="#222", width=2, fill="#fefefe")
        self.canvas.create_rectangle(x_left, y_front, x_left + mm_to_px(side_w_mm, scale), y_front + mm_to_px(side_h_mm, scale), outline="#222", width=2, fill="#f7f7f7")
        self.canvas.create_rectangle(x_right, y_front, x_right + mm_to_px(side_w_mm, scale), y_front + mm_to_px(side_h_mm, scale), outline="#222", width=2, fill="#f7f7f7")

        self.canvas.create_line(x_front + front_w / 2, y_front, x_front + front_w / 2, y_front + front_h, dash=(4, 4), fill="#caa")
        self.canvas.create_line(x_front, y_front + front_h / 2, x_front + front_w, y_front + front_h / 2, dash=(4, 4), fill="#caa")

        if self.front_image_path:
            front_img = self._load_preview_image(self.front_image_path, front_w - 20, front_h - 20)
            if front_img:
                self.front_photo = front_img
                self.canvas.create_image(x_front + 10, y_front + 10, anchor="nw", image=self.front_photo)
        else:
            self.canvas.create_text(x_front + front_w / 2, y_front + front_h / 2, text="Front Artwork", font=("Segoe UI", 13, "bold"))

        if self.back_image_path:
            back_img = self._load_preview_image(self.back_image_path, mm_to_px(side_w_mm, scale) - 20, mm_to_px(side_h_mm, scale) - 20)
            if back_img:
                self.back_photo = back_img
                self.canvas.create_image(x_left + 10, y_front + 10, anchor="nw", image=self.back_photo)

        self.summary_var.set(
            (
                f"Card size: {self.config.card_width_mm} × {self.config.card_height_mm} mm\n"
                f"Box size: {self.config.box_width_mm:.2f} × {self.config.box_depth_mm:.2f} × {self.config.box_height_mm:.2f} mm\n"
                f"Layout: {self.config.total_layout_width_mm:.2f} × {self.config.total_layout_height_mm:.2f} mm"
            )
        )

    def export_svg(self) -> None:
        if not self.front_image_path and not self.back_image_path:
            messagebox.showwarning("No artwork", "Choose at least one image before exporting.")
            return

        output_path = filedialog.asksaveasfilename(
            defaultextension=".svg",
            filetypes=[("SVG files", "*.svg")],
            title="Save tuckbox as SVG"
        )
        if not output_path:
            return

        try:
            self._write_svg(output_path)
            messagebox.showinfo("Export complete", f"SVG exported to:\n{output_path}")
        except Exception as exc:  # pragma: no cover
            messagebox.showerror("Export error", f"Unable to export SVG: {exc}")

    def export_pdf(self) -> None:
        if canvas is None:
            messagebox.showerror("Missing dependency", "reportlab is not installed. Run: pip install -r requirements.txt")
            return

        output_path = filedialog.asksaveasfilename(
            defaultextension=".pdf",
            filetypes=[("PDF files", "*.pdf")],
            title="Save tuckbox as PDF"
        )
        if not output_path:
            return

        try:
            self._write_pdf(output_path)
            messagebox.showinfo("Export complete", f"PDF exported to:\n{output_path}")
        except Exception as exc:  # pragma: no cover
            messagebox.showerror("Export error", f"Unable to export PDF: {exc}")

    def _write_svg(self, output_path: str) -> None:
        front_w = self.config.box_width_mm
        side_w = self.config.box_depth_mm
        height = self.config.box_height_mm
        full_w = front_w + (side_w * 2) + (self.config.bleed_mm * 2)
        full_h = height + (self.config.bleed_mm * 2)

        root = ET.Element(
            "svg",
            {
                "xmlns": "http://www.w3.org/2000/svg",
                "width": f"{full_w}mm",
                "height": f"{full_h}mm",
                "viewBox": f"0 0 {full_w * 10} {full_h * 10}",
            },
        )

        ET.SubElement(root, "rect", {"x": "0", "y": "0", "width": str(full_w * 10), "height": str(full_h * 10), "fill": "#ffffff"})
        ET.SubElement(root, "rect", {"x": str(self.config.bleed_mm * 10), "y": str(self.config.bleed_mm * 10), "width": str(front_w * 10), "height": str(height * 10), "fill": "#ffffff", "stroke": "#222", "stroke-width": "2"})
        ET.SubElement(root, "rect", {"x": str((self.config.bleed_mm + front_w + side_w) * 10), "y": str(self.config.bleed_mm * 10), "width": str(side_w * 10), "height": str(height * 10), "fill": "#f8f8f8", "stroke": "#222", "stroke-width": "2"})
        ET.SubElement(root, "rect", {"x": str((self.config.bleed_mm + front_w + (side_w * 2)) * 10), "y": str(self.config.bleed_mm * 10), "width": str(side_w * 10), "height": str(height * 10), "fill": "#f8f8f8", "stroke": "#222", "stroke-width": "2"})

        if self.front_image_path:
            front_uri = Path(self.front_image_path).resolve().as_uri()
            ET.SubElement(root, "image", {"href": front_uri, "x": str((self.config.bleed_mm + 5) * 10), "y": str((self.config.bleed_mm + 5) * 10), "width": str((front_w - 10) * 10), "height": str((height - 10) * 10), "preserveAspectRatio": "xMidYMid meet"})
        else:
            ET.SubElement(root, "text", {"x": str((self.config.bleed_mm + (front_w / 2)) * 10), "y": str((self.config.bleed_mm + (height / 2)) * 10), "font-size": "18", "text-anchor": "middle", "font-family": "Arial", "fill": "#222"}, text="Front")

        if self.back_image_path:
            back_uri = Path(self.back_image_path).resolve().as_uri()
            ET.SubElement(root, "image", {"href": back_uri, "x": str((self.config.bleed_mm + front_w + side_w + 5) * 10), "y": str((self.config.bleed_mm + 5) * 10), "width": str((side_w - 10) * 10), "height": str((height - 10) * 10), "preserveAspectRatio": "xMidYMid meet"})

        tree = ET.ElementTree(root)
        tree.write(output_path, encoding="utf-8", xml_declaration=True)

    def _write_pdf(self, output_path: str) -> None:
        if canvas is None or mm is None:
            raise RuntimeError("reportlab is required for PDF export")

        pdf = canvas.Canvas(output_path, pagesize=A4)
        page_width, page_height = A4

        left_margin = 18 * mm
        top_margin = 18 * mm

        layout_w = self.config.total_layout_width_mm * mm
        layout_h = self.config.total_layout_height_mm * mm

        if layout_w > page_width - (left_margin * 2):
            scale = (page_width - (left_margin * 2)) / layout_w
            layout_w *= scale
            layout_h *= scale

        x0 = left_margin
        y0 = page_height - top_margin - layout_h

        front_w = self.config.box_width_mm * mm
        side_w = self.config.box_depth_mm * mm
        height = self.config.box_height_mm * mm

        pdf.setStrokeColorRGB(0.15, 0.15, 0.15)
        pdf.setFillColorRGB(1, 1, 1)
        pdf.rect(x0, y0, front_w, height, stroke=1, fill=1)
        pdf.rect(x0 + front_w, y0, side_w, height, stroke=1, fill=1)
        pdf.rect(x0 + front_w + side_w, y0, side_w, height, stroke=1, fill=1)

        if self.front_image_path:
            try:
                pdf.drawImage(self.front_image_path, x0 + 5 * mm, y0 + 5 * mm, width=front_w - 10 * mm, height=height - 10 * mm, preserveAspectRatio=True)
            except Exception:
                pass
        else:
            pdf.setFont("Helvetica-Bold", 18)
            pdf.drawString(x0 + (front_w / 2) - 20 * mm, y0 + (height / 2), "Front")

        if self.back_image_path:
            try:
                pdf.drawImage(self.back_image_path, x0 + front_w + side_w + 5 * mm, y0 + 5 * mm, width=side_w - 10 * mm, height=height - 10 * mm, preserveAspectRatio=True)
            except Exception:
                pass

        pdf.save()


if __name__ == "__main__":
    if Image is None:
        raise RuntimeError("Pillow is required. Run: pip install -r requirements.txt")

    app = TuckboxGeneratorApp()
    app.mainloop()
